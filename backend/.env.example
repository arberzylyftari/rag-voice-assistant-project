# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real keys.

# --- Application ---
APP_ENV=development

# Comma-separated list of origins allowed to call this API.
# The default is the pinned Vite dev server port (frontend/vite.config.ts).
CORS_ORIGINS=http://localhost:5180

# --- Providers ---
# OpenAI: speech-to-text, LLM and embeddings.
OPENAI_API_KEY=

# ElevenLabs: text-to-speech (OpenAI TTS does not support Albanian).
ELEVENLABS_API_KEY=

# --- Speech-to-text ---
# Switch to whisper-1 if gpt-4o-transcribe handles Albanian accents poorly.
STT_MODEL=gpt-4o-transcribe
